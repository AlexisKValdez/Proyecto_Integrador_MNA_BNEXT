{
  "name": "MNA43 · J3 entrenamiento",
  "description": "Corrida completa del Avance 5: ajuste fino, ensambles, selección, prueba no vista, modelo final, registro @challenger y pronóstico.",
  "max_concurrent_runs": 1,
  "timeout_seconds": 28800,
  "email_notifications": {
    "on_failure": [
      "__CORREO__"
